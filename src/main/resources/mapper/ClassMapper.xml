<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.student.mapper.ClassMapper">
    
    <resultMap id="ClassResultMap" type="Class">
        <id property="id" column="id"/>
        <result property="className" column="class_name"/>
        <result property="classCode" column="class_code"/>
        <result property="description" column="description"/>
        <result property="createdTime" column="created_time"/>
        <result property="updatedTime" column="updated_time"/>
    </resultMap>
    
    <select id="findAll" resultMap="ClassResultMap">
        SELECT * FROM class ORDER BY id DESC
    </select>
    
    <select id="findById" resultMap="ClassResultMap">
        SELECT * FROM class WHERE id = #{id}
    </select>
    
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO class (class_name, class_code, description)
        VALUES (#{className}, #{classCode}, #{description})
    </insert>
    
    <update id="update">
        UPDATE class
        <set>
            <if test="className != null">class_name = #{className},</if>
            <if test="classCode != null">class_code = #{classCode},</if>
            <if test="description != null">description = #{description},</if>
        </set>
        WHERE id = #{id}
    </update>
    
    <delete id="deleteById">
        DELETE FROM class WHERE id = #{id}
    </delete>
</mapper>







